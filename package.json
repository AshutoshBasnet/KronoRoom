{
  "name": "kronoroom",
  "version": "2.0.0",
  "description": "KronoRoom v2.0 — Intelligent Classroom & Lab Booking System (London Met)",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}